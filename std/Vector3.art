class Vector3 extends Vector2 {
    local z = 0

    fun Vector3(x: Number = 0, y: Number = 0, z: Number = 0) {
        super(x, y)
        this.z = z
    }

    fun one() { return Vector3(1, 1, 1) }

    fun up() { return Vector3(0, 1, 0) }
    fun down() { return Vector3(0, -1, 0) }
    fun left() { return Vector3(1, 0, 0) }

    operator +(other) {
        return Vector3(this.x + other.x, this.y + other.y, this.z + other.z)
    }

    operator -(other) {
        return Vector3(this.x - other.x, this.y - other.y, this.z - other.z)
    }

    operator ==(other) {
        return this.x == other.x and this.y == other.y and this.z == other.z
    }

    operator *(other: Number) {
        return Vector2(this.x * other, this.y * other, this.z * other)
    }

    operator *(other: Vector2) {
        return Vector2(this.x * other.x, this.y * other.y, this.z * other.z)
    }

    get magnitude() {
        return math.sqrt((this.x * this.x) + (this.y * this.y) + (this.z * this.z))
    }

    get normal() {
        local length = this.magnitude
        return Vector3(this.x / length, this.y / length, this.z / length)
    }

    fun cross(other) {
        return Vector3(
            this.y * other.z - this.z * other.y,
            this.z * other.x - this.x * other.z,
            this.x * other.y - this.y * other.x
        )
    }

    fun toString() {
        return "(" + this.x + ", " + this.y + ", " + this.z + ")"
    }
}