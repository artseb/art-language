class Vector2 {
    local x = 0
    local y = 0

    fun Vector2(x: Number, y: Number) {
        this.x = x
        this.y = y
    }

    static fun one() { return Vector2(1, 1) }
    static fun zero() { return Vector2(0, 0) }

    static fun xAxis() { return Vector2(1, 0) }
    static fun yAxis() { return Vector2(0, 1) }

    operator +(other) {
        return Vector2(this.x + other.x, this.y + other.y)
    }

    operator -(other) {
        return Vector2(this.x - other.x, this.y - other.y)
    }

    operator ==(other) {
        return this.x == other.x and this.y == other.y
    }

    operator *(other: Number) {
        return Vector2(this.x * other, this.y * other)
    }

    operator *(other: Vector2) {
        return Vector2(this.x * other.x, this.y * other.y)
    }

    get magnitude() {
        return math.sqrt(this.x * this.x + this.y * this.y)
    }

    fun toString() {
        return "(" + this.x + ", " + this.y + ")"
    }
}
