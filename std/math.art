local math = [
    "pi" = 3.14159265358979,

    "sqrt" = fun(x) {
        return __native_math_sqrt(x)
    },

    "pow" = fun(base, exponent) {
        return __native_math_pow(base, exponent)
    },

    "abs" = fun(x) {
        return __native_math_abs(x)
    },

    "floor" = fun(x) {
        return __native_math_floor(x)
    },

    "ceil" = fun(x) {
        return __native_math_ceil(x)
    },

    "round" = fun(x) {
        return __native_math_round(x)
    },

    "min" = fun(a, b) {
        return __native_math_min(a, b)
    },

    "max" = fun(a, b) {
        return __native_math_max(a, b)
    }
]
